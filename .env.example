# Which provider to route through: "openrouter" (default) or "moonshot" (direct API)
KIMI_PROVIDER=openrouter

# --- OpenRouter (KIMI_PROVIDER=openrouter) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Moonshot direct API (KIMI_PROVIDER=moonshot) ---
# Free trial credits for new accounts — get your key at https://platform.kimi.ai
# MOONSHOT_API_KEY=sk-your-moonshot-key-here

# Optional: override the model
# (defaults: moonshotai/kimi-k3 on openrouter, kimi-k3 on moonshot)
# KIMI_MODEL_ID=moonshotai/kimi-k3
